echo "Sourcing @PROJECT_NAME@ @GIT_VERSION@ (commit @GIT_HASH@)"

@SOURCE_SOCLE@

export @PROJECT_NAME@_ROOT=@CMAKE_INSTALL_PREFIX@

PY_MAJOR=$(python3 -c 'import sys; print(sys.version_info.major)')
PY_MINOR=$(python3 -c 'import sys; print(sys.version_info.minor)')
PY_VERSION=${PY_MAJOR}.${PY_MINOR}


export PATH=$@PROJECT_NAME@_ROOT/bin:$PATH
export LD_LIBRARY_PATH=$@PROJECT_NAME@_ROOT/lib:$LD_LIBRARY_PATH
export LD_LIBRARY_PATH=$@PROJECT_NAME@_ROOT/lib/python${PY_VERSION}/site-packages:$LD_LIBRARY_PATH
export PYTHONPATH=$@PROJECT_NAME@_ROOT/lib/python${PY_VERSION}/site-packages:$PYTHONPATH


export PYTEST_PLUGINS=pytest_parallel.plugin,validation_tools.pytest.plugin

export SONICS_TEST_CASES=$@PROJECT_NAME@_ROOT/lib/python${PY_VERSION}/site-packages/sonics_test_suite/cases
